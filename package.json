{
  "name": "silk-reel",
  "description": "KiCad board in, release film out: renders a .kicad_pcb as a lit product film or a typographic loop.",
  "keywords": [
    "kicad",
    "pcb",
    "electronics",
    "video",
    "motion-graphics",
    "remotion",
    "webgl2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hridaya423/silkreel.git"
  },
  "bugs": "https://github.com/hridaya423/silkreel/issues",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint packages",
    "render:canonical": "npm run render:canonical --workspace=@silk-reel/render-api",
    "metrics:gate": "tsx packages/metrics/src/cli.ts fixtures/canonical.mp4",
    "frame-sheet": "node scripts/frame-sheet.mjs",
    "review": "tsx scripts/review.ts",
    "reel": "tsx packages/cli/src/cli.ts",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.35.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
