---
import Lettering from './Lettering.astro'
const title = 'Every board, drawn to scale.'
const then = 'The same file, as a film.'
---
<section class="dwg" id="drawing" aria-labelledby="dwg-title">
  <div class="dwg__head">
    <h2 id="dwg-title" class="dwg__title"><Lettering text={title} weight={0.06} /></h2>
    <p class="dwg__body">Scroll to travel it. Over the board, the pointer moves the cut.</p>
  </div>
  <div class="dwg__track">
    <div class="dwg__pin">
      <div class="dwg__sheet" data-dwg tabindex="0" aria-label="Drawing of the Glasgow board. Arrow keys move the section cut."></div>
      <p class="dwg__then"><Lettering text={then} weight={0.06} /></p>
    </div>
  </div>
</section>
<script>
  import { setupDrawing } from '../motion/drawing'
  setupDrawing()
</script>
<style>
  .dwg {
    --bp: #123f86;
    --bp-ink: #eaf1ff;
    --film: 0;
    --land: 0;
    position: relative; z-index: 1;
    background: color-mix(in srgb, var(--bp), var(--stock) calc(var(--film) * 100%)); color: var(--bp-ink);
  }
  .dwg__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 32px; max-width: var(--maxw); margin: 0 auto; padding: var(--sec) var(--gutter) 0; }
  .dwg__title { font-size: clamp(1.6rem, 0.6rem + 3.2vw, 4rem); line-height: 1; }
  .dwg__body { max-width: 26rem; font-size: var(--t-m); line-height: 1.45; color: rgb(234 241 255 / 0.78); }
  .dwg__track { height: 640vh; }
  .dwg__pin { position: sticky; top: 72px; height: calc(100dvh - 72px); overflow: hidden; }
  .dwg__sheet { width: 100%; height: 100%; outline: none; opacity: calc(1 - var(--film)); }
  .dwg__then { position: absolute; left: var(--gutter); bottom: var(--gutter); font-size: clamp(1rem, 0.6rem + 1.4vw, 1.75rem); opacity: clamp(0, min(var(--film) * 2 - 1, 1 - var(--land) * 4), 1); }
  .dwg__sheet:focus-visible { outline: 1px solid var(--bp-ink); outline-offset: -6px; }

  .dwg__sheet :global(.bp) { display: block; width: 100%; height: 100%; overflow: visible; --g: var(--bp); --i: var(--bp-ink); }
  .dwg__sheet :global(.bp :where(path, rect, circle, ellipse):where(:not([fill]))) { fill: none; }
  .dwg__sheet :global(.bp :is(path, rect, circle, ellipse)) { stroke: var(--i); }
  .dwg__sheet :global(.bp .fill) { fill: var(--i); stroke: none; }
  .dwg__sheet :global(.bp .body) { fill: var(--g); }
  .dwg__sheet :global(.bp .void) { fill: var(--g); stroke: none; }
  .dwg__sheet :global(.bp .halo) { stroke: var(--g); }
  .dwg__sheet :global(.bp .cu) { opacity: 0.32; }
  .dwg__sheet :global(.bp pattern path) { stroke: var(--i); }
  .dwg__sheet :global(.bp.is-cutting) { cursor: crosshair; }
  @media (max-width: 760px) { .dwg__track { height: 480vh; } }
</style>
