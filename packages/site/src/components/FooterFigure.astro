.ft__fig{aspect-ratio:1200/527;--anatomy-paper:#ecede9;--anatomy-face:#f6f6f3;--anatomy-top:#f7f7f4;--anatomy-shade-0:#d5d6d2;--anatomy-shade-1:#dddeda;--anatomy-shade-2:#e4e5e1;--anatomy-shade-3:#ebece8;--anatomy-lit-top:#f7f7f4;--anatomy-lit-shade:#e4e5e1;--anatomy-hi:#1a1a1a;--anatomy-mid:#77786f;--anatomy-lo:#a5a69f;--anatomy-faint:#c8c9c3;--anatomy-lit:#d7261e;--anatomy-halo:#6f7068;--anatomy-halo-opacity:.3;--anatomy-dot:#262626;--anatomy-weight:.6px;grid-column:1/-1;margin-top:clamp(64px,12vh,140px);min-width:0}
