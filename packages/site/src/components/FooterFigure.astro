<div class="ft__fig iso" data-theme="light" aria-hidden="true"></div>
<style is:global>
.ft__fig .iso-svg{display:block;width:100%;height:auto;overflow:visible}
.ft__fig .iso-svg path,.ft__fig .iso-svg circle{vector-effect:non-scaling-stroke}
