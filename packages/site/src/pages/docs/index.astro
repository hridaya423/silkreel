---
import Base from '../../layouts/Base.astro'
import Footer from '../../components/Footer.astro'
import Lettering from '../../components/Lettering.astro'
import { PALETTES } from '@silk-reel/choreo'
import { site } from '../../data/site'
import '../../styles/docs.css'

const toc = [
  { id: 'install', label: 'Install' },
  { id: 'command', label: 'Render a film' },
  { id: 'flags', label: 'Flags' },
  { id: 'formats', label: 'Formats' },
  { id: 'self-hosting', label: 'Self-hosting' }
]

// `backticks` mark the literal parts of a string, which set in the mono
const bits = (s: string) => s.split(/`([^`]+)`/)

const frames = [
  { ar: '4:5', size: '1080 × 1350', r: 4 / 5 },
  { ar: '1:1', size: '1080 × 1080', r: 1 },
  { ar: '9:16', size: '1080 × 1920', r: 9 / 16 },
  { ar: '16:9', size: '1920 × 1080', r: 16 / 9 }
].map((f) => ({ ...f, r: f.r.toFixed(4) }))
const palettes = (['copper', 'mono', 'blueprint', 'phosphor'] as const).map((id) => ({ id, ...PALETTES[id] }))

type Value = string | { frame: (typeof frames)[number] } | { swatch: (typeof palettes)[number] }
interface Flag { flag: string; text: string; values?: Value[]; def: string }
const groups: Array<{ name: string; rows: Flag[] }> = [
  {
    name: 'Look',
    rows: [
      { flag: '--style', text: '`trace` films the lit board. `glyph` sets its footprints as type in a loop.', values: ['`trace`', '`glyph`'], def: '`trace`' },
      { flag: '--palette', text: 'The colours of the ground, ink and light.', values: palettes.map((swatch) => ({ swatch })), def: '`copper` for trace, `mono` for glyph' },
      { flag: '--accent', text: 'One highlight colour: the growing copper tips on trace, the main chip on glyph.', values: ['`#rrggbb`'], def: 'The palette’s own' },
      { flag: '--hero', text: 'The part the film is about. The copper grows out from it and the close-up frames it.', values: ['A reference, like `U3`'], def: 'The IC with the most pads' },
      { flag: '--mask', text: 'The solder mask colour on trace.', values: ['`green`', '`black`', '`white`', '`blue`', '`red`', '`yellow`', '`purple`'], def: 'The board file’s, else `green`' }
    ]
  },
  {
    name: 'Frame',
    rows: [
      { flag: '--aspect', text: 'Composed for each frame, not cropped: 4:5 and 1:1 for feeds, 9:16 for Reels and Shorts, 16:9 for YouTube and launch pages.', values: frames.map((frame) => ({ frame })), def: '`4:5`' }
    ]
  },
  {
    name: 'Title card',
    rows: [
      { flag: '--title', text: 'Adds a title card at the end of the film.', values: ['`"Name"`'], def: 'No card' },
      { flag: '--version', text: 'Adds a version line under the title. Needs `--title`.', values: ['`"v1.0"`'], def: 'None' }
    ]
  },
  {
    name: 'Output',
    rows: [
      { flag: '-o', text: 'Where the film is saved.', values: ['A file path'], def: 'Next to the board, as `board-trace-4x5.mp4`' },
      { flag: '--format', text: 'The file type.', values: ['`mp4`', '`gif`', '`webm-alpha`', '`prores-alpha`'], def: '`mp4`' },
      { flag: '--no-audio', text: 'Leaves out the score that trace films carry.', def: 'Off' },
      { flag: '--draft', text: 'Renders faster at lower quality, to check a look before the final render.', def: 'Off' },
      { flag: '--help', text: 'Lists every flag.', def: 'Off' }
    ]
  },
  {
    name: 'Variation',
    rows: [
      { flag: '--seed', text: 'Picks the variation. The same seed gives the same film.', values: ['A number'], def: '`42`' },
      { flag: '--tempo', text: 'Sets the pace. Higher is faster and shortens the film.', values: ['`0.75` to `1.5`'], def: '`1`' }
    ]
  }
]
const formats = [
  { id: 'mp4', codec: 'H.264, AAC sound', alpha: false, use: 'Posts, READMEs, launch pages' },
  { id: 'gif', codec: 'Up to 720 px wide, no grain, no sound', alpha: false, use: 'Issues, forums, chat' },
  { id: 'webm-alpha', codec: 'VP9, Opus sound', alpha: true, use: 'Overlays on a web page or a stream' },
  { id: 'prores-alpha', codec: 'ProRes 4444, PCM sound', alpha: true, use: 'Premiere, Resolve, Final Cut' }
]
const routes = [
  { m: 'GET', p: '/health', text: 'Answers when the service is up.' },
  { m: 'GET', p: '/demos', text: 'Lists the bundled demo boards.' },
  { m: 'POST', p: '/render', text: 'Queues a render. Send `demoId` or `boardJson`, and optionally `filmConfig` and `format`. Returns 202 and a `jobId`.' },
  { m: 'GET', p: '/job/:id', text: 'Returns the job’s status and progress.' },
  { m: 'POST', p: '/job/:id/cancel', text: 'Cancels a queued or running job.' },
  { m: 'GET', p: '/download/:id', text: 'Downloads the finished file.' },
  { m: 'GET', p: '/queue', text: 'Lists every job, oldest first.' }
]
const env = [
  { name: 'SILK_REEL_GL', text: 'The Chromium GL backend. `angle` uses the GPU. Use `swangle` on a server with no GPU.', def: '`angle`' },
  { name: 'SILK_REEL_CONCURRENCY', text: 'How many frames render at once. Lower it if the browser runs out of GPU memory.', def: 'Half the cores' }
]
---
<Base title="Docs" image="/og-docs.png" description="Install silk reel and render a film from a .kicad_pcb. Every flag, format and default, plus the render API for self-hosting.">
  <div class="docs wrap">
    <header class="docs__head">
      <h1 class="xl"><Lettering text={"Render a film\nfrom the command line."} /></h1>
      <p class="lede">Install it, point it at a .kicad_pcb, and choose the look with flags. The same board and flags always render the same film.</p>
      <div class="docs__film"><canvas class="docs__frame" data-docs-film width="720" height="720" aria-hidden="true"></canvas></div>
    </header>

    <div class="docs__body">
      <nav class="docs__toc" aria-label="On this page">
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}>{t.label}</a></li>)}
        </ol>
      </nav>

      <article class="docs__main">
        <section id="install" class="doc">
          <h2 class="l"><Lettering text="Install" weight={0.09} /></h2>
          <p class="body">You need Node.js 22 or later, and <code class="mono">ffmpeg</code> and <code class="mono">ffprobe</code> on your PATH. The first render downloads a headless Chrome of about 90 MB, once. silk reel reads <code class="mono">.kicad_pcb</code> files from KiCad 4 or later; it does not read Gerber, Eagle or Altium files.</p>
          <div class="term">
            <div class="term__bar"><p class="silk">~/silk-reel</p><button type="button" class="term__copy silk" data-copy="npm install">Copy</button></div>
            <pre class="term__body"><code><span class="term__c"># in your silk reel checkout</span>
<span class="term__p">$</span>npm install</code></pre>
          </div>
        </section>

        <section id="command" class="doc">
          <h2 class="l"><Lettering text="Render a film" weight={0.09} /></h2>
          <p class="body">Give it one board file. Every flag is optional.</p>
          <div class="term">
            <div class="term__bar"><p class="silk">~/silk-reel</p><button type="button" class="term__copy silk" data-copy={site.command}>Copy</button></div>
            <pre class="term__body"><code><span class="term__p">$</span>{site.command}</code></pre>
          </div>
          <p class="body">A glyph film is an 11.2-second loop and renders in about ten seconds. A trace film runs 12 seconds, takes about 30 seconds on an Apple M4 Pro, and comes out near 8 MB. A trace render also writes <code class="mono">board.poster.png</code>, its last frame, for a cover image. <code class="mono">--draft</code> takes a fraction of the time.</p>
        </section>

        <section id="flags" class="doc">
          <h2 class="l"><Lettering text="Flags" weight={0.09} /></h2>
          <table class="ref ref--flags" aria-label="Flags">
            <colgroup><col /><col /><col /><col /></colgroup>
            <thead><tr><th scope="col">Flag</th><th scope="col">What it does</th><th scope="col">Values</th><th scope="col">Default</th></tr></thead>
            {groups.map((g) => (
              <tbody>
                <tr class="ref__group"><th scope="rowgroup" colspan="4">{g.name}</th></tr>
                {g.rows.map((f) => (
                  <tr>
                    <th scope="row"><code class="mono">{f.flag}</code></th>
                    <td class="ref__what">{bits(f.text).map((t, i) => (i % 2 ? <code class="mono">{t}</code> : t))}</td>
                    <td data-k="Values" class:list={[!f.values && 'is-blank']}>
                      {f.values && (
                        <ul class:list={['vals', f.values.some((v) => typeof v !== 'string') && 'vals--grid']}>
                          {f.values.map((v) => (
                            <li>
                              {typeof v === 'string'
                                ? bits(v).map((t, i) => (i % 2 ? <code class="mono">{t}</code> : t))
                                : 'frame' in v
                                  ? <><span class="frame" style={`--r:${v.frame.r}`} aria-hidden="true"></span><span><code class="mono">{v.frame.ar}</code><span class="vals__sub">{v.frame.size}</span></span></>
                                  : <><span class="swatch" style={`--bg:${v.swatch.bg};--cu:${v.swatch.copper};--cd:${v.swatch.copperDim}`} aria-hidden="true"></span><code class="mono">{v.swatch.id}</code></>}
                            </li>
                          ))}
                        </ul>
                      )}
                    </td>
                    <td data-k="Default">{bits(f.def).map((t, i) => (i % 2 ? <code class="mono">{t}</code> : t))}</td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
          <p class="body">A number outside its range is clamped to the nearest end.</p>
        </section>

        <section id="formats" class="doc">
          <h2 class="l"><Lettering text="Formats" weight={0.09} /></h2>
          <table class="ref ref--formats" aria-label="Formats">
            <colgroup><col /><col /><col /></colgroup>
            <thead><tr><th scope="col">Format</th><th scope="col">Codec</th><th scope="col">Use</th></tr></thead>
            <tbody>
              {formats.map((f) => (
                <tr>
                  <th scope="row"><code class="mono">{f.id}</code>{f.alpha && <span class="ref__note">Transparent background</span>}</th>
                  <td>{f.codec}</td>
                  <td>{f.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section id="self-hosting" class="doc">
          <h2 class="l"><Lettering text="Self-hosting" weight={0.09} /></h2>
          <p class="body">The render API queues renders over HTTP and runs one at a time. The <a class="prose-link" href="/studio/">studio</a> sends its full-quality renders here, and your own tools can too.</p>
          <div class="term">
            <div class="term__bar"><p class="silk">~/silk-reel</p><button type="button" class="term__copy silk" data-copy="npm run start --workspace=@silk-reel/render-api">Copy</button></div>
            <pre class="term__body"><code><span class="term__c"># serves on port 3102</span>
<span class="term__p">$</span>npm run start --workspace=@silk-reel/render-api</code></pre>
          </div>
          <table class="ref ref--routes" aria-label="Routes">
            <tbody>
              {routes.map((r) => (
                <tr>
                  <th scope="row"><span class:list={['ref__m', r.m === 'POST' && 'ref__m--post']}>{r.m}</span><code class="mono">{r.p}</code></th>
                  <td class="ref__what">{bits(r.text).map((t, i) => (i % 2 ? <code class="mono">{t}</code> : t))}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <table class="ref ref--env" aria-label="Environment variables">
            <colgroup><col /><col /><col /></colgroup>
            <thead><tr><th scope="col">Variable</th><th scope="col">What it does</th><th scope="col">Default</th></tr></thead>
            <tbody>
              {env.map((e) => (
                <tr>
                  <th scope="row"><code class="mono">{e.name}</code></th>
                  <td class="ref__what">{bits(e.text).map((t, i) => (i % 2 ? <code class="mono">{t}</code> : t))}</td>
                  <td data-k="Default">{bits(e.def).map((t, i) => (i % 2 ? <code class="mono">{t}</code> : t))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <aside class="docs__next">
          <p class="m">No board to hand? Try one of ours in the studio first.</p>
          <a class="btn btn--solid" href="/studio/">Open the studio</a>
        </aside>
      </article>
    </div>
  </div>
  <Footer slot="footer" />
</Base>

<script>
  import { ROOM } from '../../world/room'
  import { drawStill } from '../../world/world'
  import { fixtureFilm } from '../../world/films'
  import { prefersReducedMotion } from '../../engine/env'

  // the head carries the same film the home page opens on, looping while it is on screen
  const film = document.querySelector<HTMLCanvasElement>('[data-docs-film]')
  if (film) {
    void fixtureFilm('icebreaker', '1:1').then((f) => {
      const total = f.tl.totalFrames
      film.parentElement?.setAttribute('data-on', '')
      if (prefersReducedMotion()) { drawStill(film, f, Math.round(total * 0.66), ROOM, 1.5); return }
      let raf = 0, t0 = performance.now(), last = -1
      const step = (now: number) => {
        const frame = Math.floor(((now - t0) / 1000) * 30) % total
        if (frame !== last) { last = frame; drawStill(film, f, frame, ROOM, 1.5) }
        raf = requestAnimationFrame(step)
      }
      new IntersectionObserver(([e]) => {
        cancelAnimationFrame(raf)
        if (e?.isIntersecting) { t0 = performance.now() - (last < 0 ? 0 : last / 30) * 1000; raf = requestAnimationFrame(step) }
      }).observe(film)
    })
  }

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')]
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue
      links.forEach((l) => { l.toggleAttribute('aria-current', l.dataset.toc === e.target.id) })
      // on a phone the strip keeps the current section in sight
      const on = links.find((l) => l.dataset.toc === e.target.id)
      const strip = on?.closest('ol')
      if (on && strip && strip.scrollWidth > strip.clientWidth) strip.scrollTo({ left: (on.parentElement?.offsetLeft ?? 0) - parseFloat(getComputedStyle(strip).paddingLeft), behavior: 'smooth' })
    }
  }, { rootMargin: '-30% 0px -60% 0px' })
  links.forEach((l) => { const s = document.getElementById(l.dataset.toc ?? ''); if (s) io.observe(s) })
</script>
