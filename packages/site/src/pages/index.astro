---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import Lettering from '../components/Lettering.astro'
import { ASPECT_SIZE, PALETTES } from '@silk-reel/choreo'
import { aspects, boards, inks, site } from '../data/site'
import outlines from '../blueprint/outlines.json'
import '../styles/home.css'

const n = (v: number) => v.toLocaleString('en-US')
const styles = [
  { id: 'glyph', text: 'Parts set as type' },
  { id: 'trace', text: 'The lit board' },
  { id: 'plot', text: 'The board as a blueprint' },
  { id: 'montage', text: 'The board as a trailer' }
] as const
// the board picker draws each board's plan in a 2:1 box; its width dimension spans the drawn outline
const plan = (id: string) => {
  const o = outlines[id as keyof typeof outlines]
  return { ...o, span: Math.min(1, o.w / o.h / 2) * 100 }
}
const acts = ['Copper', 'Mask', 'Silk', 'Place', 'Power', 'Hold']
const looks = [
  { id: 'plot', name: 'Plot', text: 'A blueprint', alt: 'Glasgow drawn as a blueprint: its copper, pads and parts in pale ink on navy' },
  { id: 'glyph', name: 'Glyph', text: 'Parts as type', alt: 'Glasgow’s parts set as glyphs on a black board, its iCE40 lit' },
  { id: 'trace', name: 'Trace', text: 'The lit board', alt: 'Glasgow rendered lit, its parts in place and the board powered on' },
  { id: 'montage', name: 'Montage', text: 'A trailer cut', alt: 'Glasgow in x-ray: its copper glowing through a dark board' }
] as const
const rail = [{ id: '16:9', w: 140, h: 79 }, { id: '1:1', w: 88, h: 88 }, { id: '4:5', w: 88, h: 110 }, { id: '9:16', w: 80, h: 142 }]
const glasgow = boards.find((b) => b.id === 'glasgow')
// the aspect picker draws every output frame on one scale: 1920 px is 96 px
const frame = (id: keyof typeof ASPECT_SIZE) => {
  const { width, height } = ASPECT_SIZE[id]
  return { width, w: (width / 20).toFixed(1), h: (height / 20).toFixed(1) }
}
---
<Base>
  <Fragment slot="world">
    <div class="drop" data-drop aria-hidden="true">
      <p class="drop__say"><Lettering text="Drop your board" align="middle" /></p>
      <p class="drop__note">Nothing leaves this tab.</p>
    </div>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
  </Fragment>

  <div class="journey" data-journey>
    <div class="cut__visual">
      <canvas class="cut__gl" data-cut aria-hidden="true"></canvas>
      <picture>
        <source media="(max-aspect-ratio: 1/1.15)" srcset="/films/shutter/hero-phone.webp" />
        <img class="cut__still" src="/films/shutter/hero-desktop.webp" alt="Glasgow’s circuit routes turn through a red shutter into its assembled board." width="1440" height="900" fetchpriority="high" />
      </picture>
    </div>
  <section class="cut" id="film" data-stage aria-label="Glasgow: circuit routes transformed into an assembled board">
    <div class="cut__pin">

      <div class="shot shot--hero" data-shot>
        <h1 class="shot__title shot__title--hero"><Lettering text={"Turn your KiCad board\ninto a launch film."} weight={0.08} /></h1>
        <p class="shot__lede shot__lede--hero">Your copper, parts and silkscreen. No animation skills needed.</p>
        <div class="shot__acts">
          <button type="button" class="btn btn--solid try" data-try>Try your board</button>
          <button type="button" class="setup" data-copy={site.setup}>
            <span class="setup__p" aria-hidden="true">$</span><code class="setup__c">git clone {site.repo.replace('https://', '')}</code><span class="setup__k" data-copy-label data-roll>Copy</span>
          </button>
        </div>
        <p class="tag tag--src" data-src-label><span data-src-name>glasgow.kicad_pcb</span></p>
        <p class="tag tag--out" data-out-label><span class="tag__play" aria-hidden="true"></span><span data-out-name>glasgow.mp4</span></p>
        <p class="net" data-net aria-hidden="true"><span class="net__chip"><span class="net__name lt" data-net-name></span><span class="net__meta" data-net-meta></span></span></p>
      </div>

    </div>
  </section>

  <section class="frames" id="frames" aria-labelledby="frames-title" data-frames>
    <div class="frames__pin pos"><div class="frames__scene">
    <video class="frames__film" data-frames-film src="/films/frames/glasgow.mp4" poster="/films/frames/glasgow-poster.webp" muted playsinline preload="none" aria-label="Glasgow’s trace film, from bare copper to power-on"></video>
    <div class="frames__copy">
      <h2 id="frames-title" class="frames__title" data-plot-hold><Lettering text="Every frame." weight={0.08} /></h2>
      <p class="frames__lede">From copper to power-on.</p>
    </div>
    <p class="frames__act" data-frame-caption aria-live="off">The board comes to life.</p>
    <div class="strip">
      <div class="strip__film">
        <div class="strip__cells" aria-hidden="true"></div>
        <i class="strip__head" aria-hidden="true"></i>
        <input class="strip__range" type="range" min="0" max="600" step="1" value="450" aria-label="Frame of the Glasgow film" data-frames-range />
      </div>
      <ol class="strip__acts" aria-hidden="true">
        {acts.map((a) => <li data-act={a}>{a}</li>)}
      </ol>
    </div>
    </div></div>
  </section>

  </div>

  <section class="looks" id="looks" aria-labelledby="looks-title" data-looks data-look="trace">
    <h2 id="looks-title" class="looks__title"><Lettering text={"Four looks.\nOne board."} weight={0.08} /></h2>
    <div class="looks__stage">
      <div class="looks__frame" data-looks-frame></div>
      <canvas class="looks__gl" data-looks-gl aria-hidden="true"></canvas>
      {looks.map((l) => (
        <div class={`looks__arrival looks__arrival--${l.id}`}><img class={`looks__card looks__card--${l.id}`} src={`/films/looks/glasgow-${l.id}-1x.webp`} srcset={`/films/looks/glasgow-${l.id}-1x.webp 1526w, /films/looks/glasgow-${l.id}.webp 3052w`} sizes="(max-width: 760px) 100vw, 56vw" width="1526" height="928" alt={l.alt} loading="lazy" decoding="async" data-card={l.id} /></div>
      ))}
    </div>
    <div class="looks__picks" role="group" aria-label="Look">
      {looks.map((l) => (
        <button type="button" class={`look look--${l.id}`} data-look-pick={l.id} aria-pressed={l.id === 'trace' ? 'true' : 'false'}><span class="look__k">{l.name}</span><span class="look__t">{l.text}</span></button>
      ))}
    </div>
  </section>

  <section class="make" id="make" aria-labelledby="make-title">
    <header class="make__head">
      <h2 id="make-title" class="make__title"><Lettering text={"One command.\nYour board."} weight={0.1} align="middle" /></h2>
      <p class="make__body">Change a word. The film follows.</p>
    </header>
    <div class="cmd" id="get" data-cmd>
      <p class="cmd__line">
        <span class="cmd__fixed">npm run reel --</span>
        <button type="button" class="tok" popovertarget="pick-board" data-tok="board"><span class="tok__v" data-roll data-tok-v>glasgow.kicad_pcb</span><span class="sr-only">, change the board</span></button>
        <button type="button" class="tok" popovertarget="pick-style" data-tok="style"><span class="tok__f">--style</span> <span class="tok__v" data-roll data-tok-v>trace</span><span class="sr-only">, change the style</span></button>
        <button type="button" class="tok tok--live" popovertarget="pick-aspect" data-tok="aspect"><span class="tok__f">--aspect</span> <span class="tok__v" data-roll data-tok-v>16:9</span><span class="sr-only">, change the aspect</span></button>
        <button type="button" class="tok" popovertarget="pick-palette" data-tok="palette" hidden><span class="tok__f">--palette</span> <span class="tok__v" data-roll data-tok-v>mono</span><span class="sr-only">, change the palette</span></button>
      </p>
      <button type="button" class="btn btn--solid cmd__copy" data-copy={site.command} data-cmd-copy><span data-copy-label data-roll>Copy command</span></button>
    </div>
    <div class="make__run">
      <div class="monitor" data-monitor>
        <div class="monitor__stage" data-monitor-stage>
          <div class="monitor__frame" data-monitor-frame>
            <canvas data-monitor-film role="img" aria-label="The film for the command" hidden></canvas>
            <video data-monitor-video muted loop playsinline preload="none" poster="/films/trace/glasgow-16x9-poster.webp" aria-label="The film for the command"></video>
          </div>
          <div class="monitor__bar">
            <button type="button" class="monitor__play" data-monitor-play aria-label="Pause"><svg viewBox="0 0 20 20" aria-hidden="true"><path class="monitor__i-play" d="M5 3.5v13l11-6.5z" /><path class="monitor__i-pause" d="M5 3.5h3.4v13H5zM11.6 3.5H15v13h-3.4z" /></svg></button>
            <input class="monitor__seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Position in the film" data-monitor-seek />
          </div>
        </div>
        <p class="monitor__foot"><span class="monitor__credit" data-monitor-credit>{`${glasgow?.name}, ${glasgow?.maker}`}</span><span class="monitor__note" data-monitor-note hidden></span></p>
      </div>
      <div class="rail" role="group" aria-label="Aspect">
        {rail.map((a) => (
          <button type="button" class="rail__o" data-rail={a.id} aria-pressed={a.id === '16:9' ? 'true' : 'false'} style={`--rw:${a.w};--rh:${a.h}`}><span>{a.id}</span></button>
        ))}
      </div>
    </div>

    <div class="pick pick--grid pick--boards" id="pick-board" popover data-pick="board">
      <div class="pick__list" role="menu" aria-label="Board">
        {boards.map((b, i) => { const o = plan(b.id); return (
          <button type="button" role="menuitemradio" class="pick__o pick__tile" data-v={b.id} aria-checked={i === 0 ? 'true' : 'false'}>
            <svg class="pick__plan" viewBox={`-1 -1 ${o.w + 2} ${o.h + 2}`} aria-hidden="true"><path class="pick__parts" d={o.parts} /><path class="pick__hero" d={o.hero} /><path class="pick__edge" d={o.outline} />{o.holes.map(([x, y, r]) => <circle class="pick__edge" cx={x} cy={y} r={r} />)}</svg>
            <span class="dim" aria-hidden="true" style={`width:${o.span.toFixed(1)}%`}>{o.w} mm</span>
            <span class="pick__id"><span>{b.name}</span><span class="silk">{n(b.footprints)} parts</span></span>
          </button>
        )})}
        <button type="button" role="menuitem" class="pick__o pick__o--own" data-own><span>Your own board…</span><span class="silk">Stays in this tab</span></button>
      </div>
    </div>
    <div class="pick" id="pick-style" popover data-pick="style">
      <div class="pick__list" role="menu" aria-label="Style">
        {styles.map((s) => (
          <button type="button" role="menuitemradio" class="pick__o" data-v={s.id} aria-checked={s.id === 'trace' ? 'true' : 'false'}><span>{s.id}</span><span class="silk">{s.text}</span></button>
        ))}
      </div>
    </div>
    <div class="pick pick--grid pick--aspects" id="pick-aspect" popover data-pick="aspect">
      <div class="pick__list" role="menu" aria-label="Aspect">
        {aspects.map((a) => { const f = frame(a.id); return (
          <button type="button" role="menuitemradio" class="pick__o pick__tile" data-v={a.id} aria-checked={a.id === '16:9' ? 'true' : 'false'}>
            <span class="pick__stage" aria-hidden="true"><i class="pick__frame" style={`width:${f.w}px;height:${f.h}px`}></i><span class="dim" style={`width:${f.w}px`}>{f.width} px</span></span>
            <span class="pick__id"><span>{a.id}</span><span class="silk">{a.use}</span></span>
          </button>
        )})}
      </div>
    </div>
    <div class="pick pick--grid pick--inks" id="pick-palette" popover data-pick="palette">
      <div class="pick__list" role="menu" aria-label="Palette">
        {inks.map((k, i) => (
          <button type="button" role="menuitemradio" class="pick__o pick__tile" data-v={k.id} aria-checked={i === 0 ? 'true' : 'false'}>
            <canvas class="pick__still" data-still={k.id} style={`background:${PALETTES[k.id].bg}`} aria-hidden="true"></canvas>
            <span class="pick__id"><span>{k.id}</span><span class="silk">{k.text}</span></span>
          </button>
        ))}
      </div>
    </div>
  </section>
  <input class="sr-only" type="file" accept=".kicad_pcb" tabindex="-1" aria-hidden="true" data-file />


  <section class="release" aria-labelledby="release-title">
    <h2 id="release-title"><Lettering text="Your board. Ready to show." weight={0.08} /></h2>
    <a class="btn btn--solid" href="/studio/">Make your film</a>
    <a class="prose-link" href="/docs/#install">Or render on your machine</a>
  </section>
  <Footer slot="footer" />
</Base>

<script>
  import { setupHome } from '../motion/home'
  setupHome()
</script>
