---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import Lettering from '../components/Lettering.astro'
import { ASPECT_SIZE, PALETTES } from '@silk-reel/choreo'
import { aspects, boards, inks, site } from '../data/site'
import outlines from '../blueprint/outlines.json'
import '../styles/home.css'

const n = (v: number) => v.toLocaleString('en-US')
const styles = [
  { id: 'glyph', text: 'Parts set as type' },
  { id: 'trace', text: 'The lit board' },
  { id: 'plot', text: 'The board drawn in pen' }
] as const
// the board picker draws each board's plan in a 2:1 box; its width dimension spans the drawn outline
const plan = (id: string) => {
  const o = outlines[id as keyof typeof outlines]
  return { ...o, span: Math.min(1, o.w / o.h / 2) * 100 }
}
// the aspect picker draws every output frame on one scale: 1920 px is 96 px
const frame = (id: keyof typeof ASPECT_SIZE) => {
  const { width, height } = ASPECT_SIZE[id]
  return { width, w: (width / 20).toFixed(1), h: (height / 20).toFixed(1) }
}
---
<Base>
  <Fragment slot="world">
    <div class="drop" data-drop aria-hidden="true">
      <p class="drop__say"><Lettering text="Drop your board" align="middle" /></p>
      <p class="drop__note">Nothing leaves this tab.</p>
    </div>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
  </Fragment>

  <section class="cut" id="film" data-stage aria-label="The Glasgow board, as a pen plot and as a lit film">
    <div class="cut__pin">
      <canvas class="cut__gl" data-cut aria-hidden="true"></canvas>
      <img class="cut__still" src="/films/cut/glasgow-16x9-poster.webp" alt="" width="1920" height="1080" fetchpriority="high" />
      <video data-cut-video muted playsinline preload="none" hidden></video>

      <div class="shot shot--hero" data-shot>
        <h1 class="shot__title shot__title--xl"><Lettering text={"A circuit board in.\nA film out."} weight={0.055} /></h1>
        <p class="shot__lede">Give silk reel a KiCad board file. Get a release film of that board.</p>
        <div class="shot__acts">
          <button type="button" class="setup" data-copy={site.setup}>
            <span class="setup__p" aria-hidden="true">$</span><code class="setup__c">git clone {site.repo.replace('https://', '')}</code><span class="setup__k" data-copy-label data-roll>Copy</span>
          </button>
        </div>
        <p class="shot__src silk">Rendered from the Glasgow rev C3 .kicad_pcb</p>
      </div>

      <div class="shot shot--frames" data-shot inert>
        <h2 class="shot__title"><Lettering text="Every frame." weight={0.06} /></h2>
        <p class="shot__lede">Scroll runs the film. Here in pen: every track drawn as it routes out of the board file.</p>
        <div class="reel" aria-hidden="true">
          <div class="reel__strip" data-strip><i class="reel__head" data-strip-head></i></div>
          <p class="reel__tc silk" data-fn></p>
        </div>
      </div>

      <div class="shot shot--looks" data-shot inert>
        <h2 class="shot__title"><Lettering text={"Three looks.\nOne board."} weight={0.06} /></h2>
        <ol class="bands">
          <li class="band band--plot"><span class="band__k">Plot</span><span class="band__t">The board drawn in pen</span></li>
          <li class="band band--trace"><span class="band__k">Trace</span><span class="band__t">The lit board</span></li>
          <li class="band band--glyph"><span class="band__k">Glyph</span><span class="band__t">Parts set as type</span></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="make" id="make" aria-labelledby="make-title">
    <div class="make__head">
      <h2 id="make-title" class="make__title"><Lettering text={"One command.\nYour board."} weight={0.07} /></h2>
      <p class="make__body">Change a word and the film below follows. Copy the line to render it on your machine.</p>
    </div>
    <div class="make__run">
      <div class="cmd pos" id="get" data-cmd>
        <p class="cmd__line">
          <span class="cmd__p" aria-hidden="true">$</span>
          <span class="cmd__fixed">npm run reel --</span>
          <button type="button" class="tok" popovertarget="pick-board" data-tok="board"><span data-roll data-tok-v>icebreaker.kicad_pcb</span><span class="sr-only">, change the board</span></button>
          <button type="button" class="tok" popovertarget="pick-style" data-tok="style"><span class="tok__f">--style</span> <span data-roll data-tok-v>trace</span><span class="sr-only">, change the style</span></button>
          <button type="button" class="tok" popovertarget="pick-aspect" data-tok="aspect"><span class="tok__f">--aspect</span> <span data-roll data-tok-v>16:9</span><span class="sr-only">, change the aspect</span></button>
          <button type="button" class="tok" popovertarget="pick-palette" data-tok="palette" hidden><span class="tok__f">--palette</span> <span data-roll data-tok-v>mono</span><span class="sr-only">, change the palette</span></button>
        </p>
        <div class="cmd__acts">
          <button type="button" class="btn btn--solid" data-copy={site.command} data-cmd-copy><span data-copy-label data-roll>Copy the command</span></button>
          <a class="btn" href="/studio/">Open studio</a>
        </div>
        <p class="cmd__once">Runs from a clone of the repo. First time: <button type="button" class="cmd__setup" data-copy={site.setup}><code>{site.setup}</code><span class="cmd__setup-k" data-copy-label data-roll>Copy</span></button></p>
      </div>
      <div class="monitor" data-monitor>
        <div class="monitor__stage" data-monitor-stage>
          <canvas data-monitor-film role="img" aria-label="The film for the command" hidden></canvas>
          <video data-monitor-video muted loop playsinline preload="none" poster="/films/trace/icebreaker-poster.webp" aria-label="The trace film for the command"></video>
          <canvas data-monitor-plot role="img" aria-label="The plot film for the command" hidden></canvas>
          <span class="dim dim--w" data-dim-w>{ASPECT_SIZE['16:9'].width} px</span>
          <span class="dim dim--h" data-dim-h>{ASPECT_SIZE['16:9'].height} px</span>
        </div>
        <div class="monitor__foot">
          <p class="monitor__note" data-monitor-note hidden></p>
          <p class="monitor__credit" data-monitor-credit>{`${boards[0]?.name}, ${boards[0]?.maker}`}</p>
          <p class="monitor__tc silk" aria-hidden="true" data-monitor-tc>00:00.00</p>
        </div>
      </div>
    </div>

    <div class="pick pick--grid pick--boards" id="pick-board" popover data-pick="board">
      <div class="pick__list" role="menu" aria-label="Board">
        {boards.map((b, i) => { const o = plan(b.id); return (
          <button type="button" role="menuitemradio" class="pick__o pick__tile" data-v={b.id} aria-checked={i === 0 ? 'true' : 'false'}>
            <svg class="pick__plan" viewBox={`-1 -1 ${o.w + 2} ${o.h + 2}`} aria-hidden="true"><path class="pick__parts" d={o.parts} /><path class="pick__hero" d={o.hero} /><path class="pick__edge" d={o.outline} />{o.holes.map(([x, y, r]) => <circle class="pick__edge" cx={x} cy={y} r={r} />)}</svg>
            <span class="dim" aria-hidden="true" style={`width:${o.span.toFixed(1)}%`}>{o.w} mm</span>
            <span class="pick__id"><span>{b.name}</span><span class="silk">{n(b.footprints)} parts</span></span>
          </button>
        )})}
        <button type="button" role="menuitem" class="pick__o pick__o--own" data-own><span>Your own board…</span><span class="silk">Stays in this tab</span></button>
      </div>
    </div>
    <div class="pick" id="pick-style" popover data-pick="style">
      <div class="pick__list" role="menu" aria-label="Style">
        {styles.map((s) => (
          <button type="button" role="menuitemradio" class="pick__o" data-v={s.id} aria-checked={s.id === 'trace' ? 'true' : 'false'}><span>{s.id}</span><span class="silk">{s.text}</span></button>
        ))}
      </div>
    </div>
    <div class="pick pick--grid pick--aspects" id="pick-aspect" popover data-pick="aspect">
      <div class="pick__list" role="menu" aria-label="Aspect">
        {aspects.map((a) => { const f = frame(a.id); return (
          <button type="button" role="menuitemradio" class="pick__o pick__tile" data-v={a.id} aria-checked={a.id === '16:9' ? 'true' : 'false'}>
            <span class="pick__stage" aria-hidden="true"><i class="pick__frame" style={`width:${f.w}px;height:${f.h}px`}></i><span class="dim" style={`width:${f.w}px`}>{f.width} px</span></span>
            <span class="pick__id"><span>{a.id}</span><span class="silk">{a.use}</span></span>
          </button>
        )})}
      </div>
    </div>
    <div class="pick pick--grid pick--inks" id="pick-palette" popover data-pick="palette">
      <div class="pick__list" role="menu" aria-label="Palette">
        {inks.map((k, i) => (
          <button type="button" role="menuitemradio" class="pick__o pick__tile" data-v={k.id} aria-checked={i === 0 ? 'true' : 'false'}>
            <canvas class="pick__still" data-still={k.id} style={`background:${PALETTES[k.id].bg}`} aria-hidden="true"></canvas>
            <span class="pick__id"><span>{k.id}</span><span class="silk">{k.text}</span></span>
          </button>
        ))}
      </div>
    </div>
  </section>
  <input class="sr-only" type="file" accept=".kicad_pcb" tabindex="-1" aria-hidden="true" data-file />


  <Footer slot="footer" />
</Base>

<script>
  import { setupHome } from '../motion/home'
  setupHome()
</script>
